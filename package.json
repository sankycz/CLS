{
  "name": "cls",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Výcviková offline PWA pro postup TCCC Combat Lifesaver (MARCH PAWS, 9-Line, MIST, DD 1380)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-worker.mjs",
